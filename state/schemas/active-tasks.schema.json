{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openclaw.local/schemas/active-tasks.schema.json",
  "title": "Active Tasks Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskEntry"
      }
    }
  },
  "$defs": {
    "taskStatus": {
      "type": "string",
      "enum": ["pending", "running", "retrying"]
    },
    "taskEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "taskId",
        "description",
        "project",
        "projectPath",
        "acpSessionKey",
        "threadId",
        "startedAt",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "projectPath": {
          "type": "string",
          "minLength": 1
        },
        "acpSessionKey": {
          "type": "string",
          "minLength": 1
        },
        "threadId": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "$ref": "#/$defs/taskStatus"
        }
      }
    }
  }
}
